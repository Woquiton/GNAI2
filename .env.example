APP_NAME=GNAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

OSM_API_URL=https://nominatim.openstreetmap.org/search
OSM_USER_AGENT="SeuNome - seuemail@example.com"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gnai_db
DB_USERNAME=gnai_user
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

BACKUP_DISK_NAME=GNAIbackups
BACKUP_MYSQL_BINARY_PATH=/usr/bin
BACKUP_MYSQL_EXTRA_OPTIONS="--protocol=tcp --skip-ssl"
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAIL_TO=backup@example.com

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_LOCK_AFTER=15
SESSION_LOGOUT_AFTER=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"
